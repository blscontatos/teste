# =============================================================================
# Luiz Vieira Negócios Imobiliários — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na sua hospedagem (Vercel).
# =============================================================================

# URL pública do site (sem barra no final). Usada em SEO, sitemap e e-mails.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Supabase → Project Settings → API Keys
# Aceita a chave nova "Publishable key" (sb_publishable_...) ou a antiga "anon".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon

# SOMENTE SERVIDOR — nunca exponha no navegador, nunca use prefixo NEXT_PUBLIC.
# Aceita a chave nova "Secret key" (sb_secret_...) ou a antiga "service_role".
# Necessária para: criar o primeiro administrador (script) e cadastrar corretores pelo painel.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Número padrão do WhatsApp (somente dígitos, com DDI e DDD), usado enquanto
# não for configurado no painel em Configurações → WhatsApp.
NEXT_PUBLIC_WHATSAPP_FALLBACK=5521999999999
