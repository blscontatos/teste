# =============================================================================
# PK Salgados e Doces — variáveis de ambiente
# Copie para .env.local (no computador) ou cadastre na Vercel (Settings → Environment Variables).
# =============================================================================

# Endereço do site, sem barra no final (usado no Google e no WhatsApp).
NEXT_PUBLIC_SITE_URL=https://pksalgados.com.br

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (sb_publishable_...) ou a antiga "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica

# SOMENTE para o script que cria o acesso das donas (npm run admin:criar).
# Não é necessária na Vercel. Nunca coloque NEXT_PUBLIC na frente.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-secreta
